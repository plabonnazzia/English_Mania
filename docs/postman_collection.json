{
  "info": {
    "_postman_id": "english-prep-platform-phase3",
    "name": "English Test Prep Platform \u2014 Full API (Phases 2-3)",
    "description": "All endpoints per PROJECT_BRIEF.md Section 6. Import into Postman, set 'baseUrl' (default http://localhost:5000), run Auth Register -> Login first (Login auto-saves 'token'). Seed data required: npm run db:seed. Admin endpoints need the admin token (admin@example.com / admin1234) \u2014 log in as admin and overwrite 'token' to test them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "testId",
      "value": ""
    },
    {
      "key": "lessonId",
      "value": ""
    },
    {
      "key": "flashcardId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Register \u2014 POST /api/auth/register {name,email,password} -> 201 {token,user}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"student@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login \u2014 POST /api/auth/login -> 200 {token,user}. Saves token."
          },
          "response": []
        },
        {
          "name": "Me (protected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Me (protected) \u2014 GET /api/auth/me -> 200 {user}"
          },
          "response": []
        }
      ]
    },
